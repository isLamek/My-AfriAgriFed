# Copy to .env and fill in real values. Never commit the real .env file.

# --- Cloudinary (image/PDF uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Flutterwave (online payments / split payouts) ---
# Get these from the Flutterwave dashboard (use TEST keys first).
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_ENCRYPTION_KEY=

# Platform commission taken from every sale, as a fraction (0.05 = 5%),
# matching the financial model in the concept note.
PLATFORM_COMMISSION_RATE=0.05

# Base URL the frontend is served from, used to build payment redirect URLs.
APP_BASE_URL=http://localhost:3000

# --- Weather and fire data (server.js caches these for every visitor) ---
# Open-Meteo commercial key. Leave empty in development (free, non-commercial
# tier is used); REQUIRED for a commercial launch. See docs/SETUP_GUIDE.pdf.
OPEN_METEO_API_KEY=
# NASA FIRMS map key (free). Leave empty to switch the fire layer off.
FIRMS_MAP_KEY=

# Firebase admin key (REQUIRED for payments). Firebase console -> Project settings ->
# Service accounts -> Generate new private key. Paste the file as ONE line, or its base64
# (see docs/SETUP_GUIDE.pdf). Without it the server refuses to take any payment.
# For local development you can instead point at the downloaded file:
# FIREBASE_SERVICE_ACCOUNT_FILE=C:\path	o\serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Hosting the backend ---
# Comma-separated website addresses allowed to call the API. Empty = any.
CORS_ORIGINS=
# Set to 1 when the backend sits behind a host's load balancer (Render, Railway, Fly).
TRUST_PROXY=
# Requests per minute per visitor for the weather and fire endpoints.
RATE_LIMIT_PER_MINUTE=120
# ...and for the payment endpoints.
PAYMENT_RATE_LIMIT_PER_MINUTE=30

PORT=5000

# --- Frontend (must be prefixed REACT_APP_ for react-scripts to inline it) ---
# URL of the server.js backend above, used for Cloudinary uploads and payments.
REACT_APP_API_URL=http://localhost:5000

# --- Build tooling ---
# react-scripts 5's bundled ESLint config chokes on this Node/npm toolchain
# combination (a known react-scripts@5 + eslint-plugin-jest@25 + @typescript-eslint
# incompatibility unrelated to this app's code - "Environment key jest/globals
# is unknown"). Disabling the webpack ESLint pass unblocks `npm run build`;
# babel/webpack still fail the build on real syntax errors either way.
DISABLE_ESLINT_PLUGIN=true
