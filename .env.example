# Copy to .env and fill in real values. Never commit the real .env file.

# --- Cloudinary (image/PDF uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Flutterwave (online payments / split payouts) ---
# Get these from the Flutterwave dashboard (use TEST keys first).
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
FLW_ENCRYPTION_KEY=

# Platform commission taken from every sale, as a fraction (0.05 = 5%),
# matching the financial model in the concept note.
PLATFORM_COMMISSION_RATE=0.05

# Base URL the frontend is served from, used to build payment redirect URLs.
APP_BASE_URL=http://localhost:3000

PORT=5000

# --- Frontend (must be prefixed REACT_APP_ for react-scripts to inline it) ---
# URL of the server.js backend above, used for Cloudinary uploads and payments.
REACT_APP_API_URL=http://localhost:5000

# --- Build tooling ---
# react-scripts 5's bundled ESLint config chokes on this Node/npm toolchain
# combination (a known react-scripts@5 + eslint-plugin-jest@25 + @typescript-eslint
# incompatibility unrelated to this app's code - "Environment key jest/globals
# is unknown"). Disabling the webpack ESLint pass unblocks `npm run build`;
# babel/webpack still fail the build on real syntax errors either way.
DISABLE_ESLINT_PLUGIN=true
