rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// or paste into Firebase Console -> Firestore Database -> Rules.
//
// Admin access model:
//   - admins/{email}  (email lowercased) is the source of truth for who can
//     reach the Admin Dashboard, with a role of founder | developer | moderator.
//   - Only founders can add/remove other admins.
//   - The very first admin is created through a one-time "bootstrap": while
//     system/bootstrap.founderClaimed is not yet true, a signed-in user can
//     make THEMSELVES (and only themselves) a founder.
//   - admin/{uid} is the legacy scheme kept for backward compatibility.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    // Firebase lets anyone sign up with any e-mail address without proving they own
    // it, so admin rights only count for a VERIFIED address (the app's Admin area
    // makes people verify first; see src/VerifyEmail.js).
    function emailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAdminEmail(email) {
      return exists(/databases/$(database)/documents/admins/$(email));
    }

    function adminData(email) {
      return get(/databases/$(database)/documents/admins/$(email)).data;
    }

    function isFounderEmail(email) {
      return isAdminEmail(email) && adminData(email).role == 'founder';
    }

    function isSignedInAdmin() {
      return signedIn() && emailVerified() && isAdminEmail(myEmail());
    }

    function isSignedInFounder() {
      return signedIn() && emailVerified() && isFounderEmail(myEmail());
    }

    function founderSeatUnclaimed() {
      return !exists(/databases/$(database)/documents/system/bootstrap)
        || get(/databases/$(database)/documents/system/bootstrap).data.founderClaimed != true;
    }

    // A real (non-anonymous) account - always gets free access per the
    // concept note ("zero fee charged on app" for data/statistics).
    function isRegisteredUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Anonymous visitor who paid N$5 for this specific page, or verified as
    // a student (which unlocks every paywalled page).
    function hasPageAccess(page) {
      return signedIn()
        && exists(/databases/$(database)/documents/pageAccess/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/pageAccess/$(request.auth.uid)).data[page] == true ||
          get(/databases/$(database)/documents/pageAccess/$(request.auth.uid)).data.studentVerified == true
        );
    }

    // ---- bootstrap flag ----
    match /system/bootstrap {
      allow get: if true;
      allow create, update: if signedIn()
        && founderSeatUnclaimed()
        && request.resource.data.founderClaimed == true
        && request.resource.data.claimedBy == myEmail();
      allow delete: if isSignedInFounder();
    }

    // ---- email-keyed admin roster (current scheme) ----
    match /admins/{email} {
      allow get: if signedIn() && (myEmail() == email || isSignedInAdmin());
      allow list: if isSignedInAdmin();
      allow create: if isSignedInFounder()
        || (
          signedIn()
          && emailVerified()
          && myEmail() == email
          && request.resource.data.role == 'founder'
          && founderSeatUnclaimed()
        );
      allow update, delete: if isSignedInFounder();
    }

    // ---- legacy uid-keyed admin flag ----
    match /admin/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isSignedInAdmin());
      allow write: if isSignedInFounder();
    }

    // ---- application data ----
    // Approval is an admin decision (the Verification Queue). Until now an owner
    // could write approved:true into their own profile and skip verification, so:
    //  - a new profile must start unapproved and pending (Register.js does this);
    //  - an owner can edit their details but never approved / status / accountStatus /
    //    userType (so a consumer cannot turn themselves into a verified farmer);
    //  - only admins change those.
    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('approved', false) != true
        && request.resource.data.get('status', 'pending') == 'pending'
        && request.resource.data.get('accountStatus', {}).get('registrationStatus', 'pending') == 'pending'
        && request.resource.data.get('accountStatus', {}).get('documentStatus', 'submitted') in ['submitted', 'not_required', 'pending']
        && request.resource.data.get('userType', 'consumer') in ['farmer', 'consumer', 'institution'];
      allow read: if signedIn() && (request.auth.uid == uid || isSignedInAdmin());
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approved', 'status', 'accountStatus', 'userType', 'reviewedAt', 'reviewedBy']))
        || isSignedInAdmin()
      );
      allow delete: if isSignedInAdmin();
    }

    // Same approval test the app uses (see isApprovedStatus in src/App.js). Users can no
    // longer write these fields themselves (see /users below), only admins can.
    function isApprovedFarmer() {
      let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me.get('userType', '') == 'farmer'
        && (
          me.get('approved', false) == true
          || me.get('status', '') in ['approved', 'verified']
          || me.get('accountStatus', {}).get('registrationStatus', '') == 'verified'
          || me.get('accountStatus', {}).get('documentStatus', '') == 'approved'
        );
    }

    match /marketPrices/{id} {
      allow read: if true;
      allow create: if signedIn() && isApprovedFarmer() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.sellerId == request.auth.uid || isSignedInAdmin());
    }

    // Safe, PII-free aggregate counts for the public Data Dashboard.
    // Refreshed opportunistically whenever an admin opens the Admin Dashboard.
    // The only consumer of this doc is the paywalled Data Dashboard (unlike
    // marketPrices/trainingPrograms/etc. below, which stay openly readable
    // because they're also used for legitimate free browsing elsewhere) -
    // so this is the one place the N$5-per-page paywall is actually
    // enforced at the database level, not just in the page's UI.
    match /publicStats/{id} {
      allow read: if isRegisteredUser() || hasPageAccess('data');
      allow write: if isSignedInAdmin();
    }

    match /institutionResearchArticles/{id} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn() && (resource.data.authorId == request.auth.uid || isSignedInAdmin());
    }

    match /researchProblems/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.farmerId == request.auth.uid;
      allow update: if signedIn(); // institutions mark answered; farmer can only own their doc
      allow delete: if isSignedInAdmin();
    }

    match /trainingPrograms/{id} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn() && (resource.data.institutionId == request.auth.uid || isSignedInAdmin());
    }

    match /internships/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.postedById == request.auth.uid;
      allow update: if signedIn();
      allow delete: if isSignedInAdmin();
    }

    // A promotion becomes "active" only when the server has seen the payment
    // (server/checkout.js); the owner can never set status or paid fields.
    match /promotions/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.farmerId == request.auth.uid
        && request.resource.data.status == 'pending_payment'
        && !('paidAmount' in request.resource.data)
        && !('transactionId' in request.resource.data);
      allow update: if signedIn() && (
        (resource.data.farmerId == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'paidAmount', 'transactionId', 'farmerId']))
        || isSignedInAdmin()
      );
      allow delete: if signedIn() && (resource.data.farmerId == request.auth.uid || isSignedInAdmin());
    }

    // Shape matches src/notifications.js (and the server's own notifications, which
    // bypass these rules). Anyone signed in may still notify someone else, as the
    // app's flows need (a pledge, an internship decision), but not with arbitrary
    // fields or oversized text, and a recipient can only mark one as read.
    match /notifications/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['userId', 'title', 'body', 'link', 'read', 'createdAt'])
        && request.resource.data.userId is string && request.resource.data.userId.size() > 0 && request.resource.data.userId.size() <= 128
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.get('body', '') is string && request.resource.data.get('body', '').size() <= 400
        && request.resource.data.get('link', '/') is string && request.resource.data.get('link', '/').matches('^/[A-Za-z0-9/_-]{0,80}$')
        && request.resource.data.get('read', false) == false
        && request.resource.data.createdAt == request.time;
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    match /telemetry/{id} {
      allow create: if true;
      allow read: if isSignedInAdmin();
    }

    // Anonymous-visitor paywall for Data/Statistics Dashboard (concept note:
    // free once registered, N$5/page or student verification otherwise).
    // Keyed by the visitor's anonymous Firebase Auth uid, own-doc only.
    // The paid flags (data, statistics) are written by the server after Flutterwave
    // confirms a payment. A visitor may record only their own student self-verification.
    match /pageAccess/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSignedInAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['studentVerified', 'studentCardUrl', 'verifiedAt']);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentVerified', 'studentCardUrl', 'verifiedAt']);
      allow write: if isSignedInAdmin();
    }

    // The server's own record of each payment it started. Never touched by browsers.
    match /payments/{id} {
      allow read, write: if false;
    }

    match /studentAccessRequests/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedInAdmin();
    }

    function validDemand(d) {
      return d.buyerId == request.auth.uid
        && d.status == 'open'
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.product is string && d.product.size() > 0 && d.product.size() <= 80
        && d.quantityNeeded is number && d.quantityNeeded > 0 && d.quantityNeeded <= 10000000
        && d.unit in ['kg', 'ton', 'unit', 'crate', 'litre']
        && (d.get('notes', '') is string) && d.get('notes', '').size() <= 600;
    }

    match /demandRequests/{id} {
      allow read: if true;
      allow create: if signedIn() && validDemand(request.resource.data);
      allow update, delete: if signedIn() && (resource.data.buyerId == request.auth.uid || isSignedInAdmin());

      // Only producer (farmer) accounts pledge, never to their own request, and
      // only while it is open. Mirrors src/demandRules.js.
      match /pledges/{pledgeId} {
        allow read: if true;
        allow create: if isFarmerAccount()
          && request.resource.data.farmerId == request.auth.uid
          && request.resource.data.quantity is number
          && request.resource.data.quantity > 0 && request.resource.data.quantity <= 10000000
          && request.resource.data.get('note', '') is string
          && request.resource.data.get('note', '').size() <= 200
          && get(/databases/$(database)/documents/demandRequests/$(id)).data.status == 'open'
          && get(/databases/$(database)/documents/demandRequests/$(id)).data.buyerId != request.auth.uid;
        allow update, delete: if signedIn() && (resource.data.farmerId == request.auth.uid || isSignedInAdmin());
      }

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Order progress. Mirrors src/orderStatus.js - keep the two in sync.
    //   paid -> confirmed -> dispatched -> in_transit -> delivered
    // The seller moves an order up to in_transit; only the buyer can confirm
    // delivery (from dispatched or in_transit). Everything else (cancelling,
    // refunds, corrections) stays admin-only.
    function sellerMove(from, to) {
      return (from == 'paid' && to == 'confirmed')
        || (from == 'confirmed' && to == 'dispatched')
        || (from == 'dispatched' && to == 'in_transit');
    }

    function buyerMove(from, to) {
      return (from == 'dispatched' || from == 'in_transit') && to == 'delivered';
    }

    // A participant may change ONLY status, statusHistory and updatedAt; the
    // history must grow by exactly one entry that names the new status and
    // the person making the change, and updatedAt must be the server time.
    function isLegalOrderProgress() {
      let before = resource.data;
      let after = request.resource.data;
      return signedIn()
        && after.diff(before).affectedKeys().hasOnly(['status', 'statusHistory', 'updatedAt'])
        && after.statusHistory is list
        && after.statusHistory.size() == before.get('statusHistory', []).size() + 1
        && after.statusHistory[after.statusHistory.size() - 1].status == after.status
        && after.statusHistory[after.statusHistory.size() - 1].by == request.auth.uid
        && after.updatedAt == request.time
        && (
          (before.sellerId == request.auth.uid && sellerMove(before.status, after.status))
          || (before.buyerId == request.auth.uid && buyerMove(before.status, after.status))
        );
    }

    // ---- Farmers' private farm records and input log ------------------------
    // Only farmer accounts create these; only the owner (and admins, for
    // support) can read them. Mirrors src/farmview/farmInputs.js limits.
    function isFarmerAccount() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'farmer';
    }

    function validFarm(d) {
      return d.keys().hasOnly(['ownerId', 'name', 'lat', 'lng', 'region', 'crops', 'areaHa', 'notes', 'createdAt', 'updatedAt'])
        && d.ownerId == request.auth.uid
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.lat is number && d.lat >= -29.7 && d.lat <= -16.4
        && d.lng is number && d.lng >= 11.0 && d.lng <= 25.9
        && (!('region' in d) || (d.region is string && d.region.size() <= 40))
        && (!('crops' in d) || (d.crops is list && d.crops.size() <= 12))
        && (!('areaHa' in d) || (d.areaHa is number && d.areaHa >= 0 && d.areaHa <= 100000))
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 500));
    }

    function validFarmInput(d) {
      return d.keys().hasOnly(['ownerId', 'farmId', 'date', 'type', 'item', 'quantity', 'unit', 'costNad', 'target', 'note', 'createdAt'])
        && d.ownerId == request.auth.uid
        && d.farmId is string && d.farmId.size() > 0 && d.farmId.size() <= 40
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.type in ['seed', 'fertiliser', 'pesticide', 'herbicide', 'water', 'labour', 'feed', 'veterinary', 'equipment', 'other']
        && d.item is string && d.item.size() > 0 && d.item.size() <= 80
        && (!('quantity' in d) || (d.quantity is number && d.quantity >= 0))
        && (!('unit' in d) || (d.unit is string && d.unit.size() <= 20))
        && (!('costNad' in d) || (d.costNad is number && d.costNad >= 0))
        && (!('target' in d) || (d.target is string && d.target.size() <= 60))
        && (!('note' in d) || (d.note is string && d.note.size() <= 300));
    }

    match /farms/{id} {
      allow create: if isFarmerAccount() && validFarm(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || isSignedInAdmin());
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && validFarm(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /farmInputs/{id} {
      allow create: if isFarmerAccount() && validFarmInput(request.resource.data)
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/farms/$(request.resource.data.farmId)).data.ownerId == request.auth.uid;
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || isSignedInAdmin());
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && validFarmInput(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /orders/{id} {
      // Created by the server once a payment is confirmed (server/checkout.js), never by a browser.
      allow create: if false;
      allow read: if signedIn() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isSignedInAdmin()
      );
      allow update: if isSignedInAdmin() || isLegalOrderProgress();
    }
  }
}
